<?xml version="1.0"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <parent>
        <artifactId>keycloak-parent</artifactId>
        <groupId>org.keycloak</groupId>
        <version>999.0.0-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>keycloak-themes</artifactId>
    <name>Keycloak Themes</name>
    <description>Keycloak Themes</description>
    <packaging>jar</packaging>

    <dependencies>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-admin-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-account-ui</artifactId>
        </dependency>
        <dependency>
            <groupId>org.keycloak</groupId>
            <artifactId>keycloak-themes-vendor</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <!-- Copy shared scripts first so legacy source files take precedence. -->
            <resource>
                <directory>src/main/resources/theme/base/login/resources/js</directory>
                <targetPath>theme/base-legacy/login/resources/js</targetPath>
                <includes>
                    <include>**/*.js</include>
                </includes>
                <excludes>
                    <exclude>password-policy.js</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Share the Weblate login bundles with the standalone legacy theme. -->
            <resource>
                <directory>src/main/resources/theme/base/login/messages</directory>
                <targetPath>theme/base-legacy/login/messages</targetPath>
                <includes>
                    <include>messages_*.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <configuration>
                    <!-- Apply legacy script and shared locale overrides regardless of timestamps. -->
                    <overwrite>true</overwrite>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.keycloak</groupId>
                <artifactId>theme-verifier-maven-plugin</artifactId>
                <version>${project.version}</version>
                <executions>
                    <execution>
                        <id>verify-theme</id>
                        <goals>
                            <goal>verify-theme</goal>
                        </goals>
                        <configuration>
                            <validateMessageFormatQuotes>true</validateMessageFormatQuotes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>communityTranslations</id>
            <activation>
                <property>
                    <name>!skipCommunityTranslations</name>
                </property>
            </activation>
            <build>
                <resources>
                    <resource>
                        <directory>src/main/resources-community</directory>
                    </resource>
                    <resource>
                        <directory>src/main/resources-community/theme/base/login</directory>
                        <targetPath>theme/base-legacy/login</targetPath>
                        <includes>
                            <include>messages/messages_*.properties</include>
                            <include>theme.properties</include>
                        </includes>
                    </resource>
                </resources>
            </build>
        </profile>
    </profiles>
</project>
