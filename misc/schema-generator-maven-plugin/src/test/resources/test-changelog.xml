<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.2.xsd">

    <changeSet author="keycloak" id="1.0.0-test-table">
        <preConditions onFail="MARK_RAN" onSqlOutput="TEST">
            <not>
                <tableExists tableName="TEST_ENTITY"/>
            </not>
        </preConditions>
        <createTable tableName="TEST_ENTITY">
            <column name="ID" type="VARCHAR(36)">
                <constraints nullable="false" primaryKey="true" primaryKeyName="PK_TEST_ENTITY"/>
            </column>
            <column name="NAME" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="ENABLED" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet author="keycloak" id="1.1.0-test-index">
        <preConditions onFail="MARK_RAN" onSqlOutput="TEST">
            <and>
                <tableExists tableName="TEST_ENTITY"/>
                <not>
                    <indexExists tableName="TEST_ENTITY" indexName="IDX_TEST_ENTITY_NAME"/>
                </not>
            </and>
        </preConditions>
        <createIndex indexName="IDX_TEST_ENTITY_NAME" tableName="TEST_ENTITY">
            <column name="NAME"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
