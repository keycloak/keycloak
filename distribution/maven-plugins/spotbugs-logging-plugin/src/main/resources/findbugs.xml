<!--
  SpotBugs plugin descriptor for the Keycloak logging format string detector.
  This file tells SpotBugs which Detector classes to load and which BugPattern
  codes they may report.
-->
<FindbugsPlugin xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                xsi:noNamespaceSchemaLocation="findbugsplugin.xsd"
                pluginid="org.keycloak.spotbugs.logging"
                provider="Keycloak"
                website="https://github.com/keycloak/keycloak">

    <Detector class="org.keycloak.spotbugs.LoggingFormatStringDetector"
              speed="fast"
              reports="LOGGING_FORMAT_ARG_COUNT_MISMATCH,LOGGING_FORMAT_WRONG_SYNTAX"
              hidden="false"/>

    <BugPattern type="LOGGING_FORMAT_ARG_COUNT_MISMATCH"
                abbrev="LFAC"
                category="CORRECTNESS"/>

    <BugPattern type="LOGGING_FORMAT_WRONG_SYNTAX"
                abbrev="LFWS"
                category="CORRECTNESS"/>

</FindbugsPlugin>
