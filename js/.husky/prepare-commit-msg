#!/usr/bin/env sh

# Automatically add a Signed-off-by trailer (DCO) when missing.
# Equivalent to always passing `git commit --signoff`.

COMMIT_MSG_FILE=$1

NAME=$(git config --get user.name)
EMAIL=$(git config --get user.email)

if [ -z "$NAME" ] || [ -z "$EMAIL" ]; then
  exit 0
fi

SOB="Signed-off-by: $NAME <$EMAIL>"

# Avoid duplicating the same sign-off line.
if grep -qF -- "$SOB" "$COMMIT_MSG_FILE"; then
  exit 0
fi

git interpret-trailers --trailer "$SOB" --in-place "$COMMIT_MSG_FILE"
