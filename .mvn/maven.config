# HTTP transport settings for Maven Resolver 1.9.x (Maven 3.9.x); Maven 4 uses aether.transport.http.* instead.
# Drop pooled connections after 25 seconds (default: 300), as GitHub runners kept reusing connections that were already closed (https://github.com/keycloak/keycloak/pull/22946).
-Daether.connector.http.connectionMaxTtl=25
# Retry failed downloads up to 5 times (default: 3), as Maven Central occasionally fails a single artifact with a transient error.
-Daether.connector.http.retryHandler.count=5
# By default only 429 and 503 are retried with a back-off (default: 429,503); add 502 (Bad Gateway) and 504 (Gateway Timeout).
# See https://github.com/apache/maven-resolver/issues/2151 for a request to make this configurable and to cover more status codes.
-Daether.connector.http.retryHandler.serviceUnavailable=429,502,503,504
